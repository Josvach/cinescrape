# Neon Postgres (Vercel Marketplace gives you this automatically)
DATABASE_URL="postgres://user:pass@host/db?sslmode=require"

# Shared secret for the /api/cron/* endpoints. Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`; generate with `openssl rand -hex 32`.
CRON_SECRET=""

# Public client key that cinestar.cz ships in its own frontend config and that
# api.cinestar.cz requires on /api/token/create. Not a secret in any meaningful
# sense, but it is their config and not ours, so it stays out of the repo.
CINESTAR_API_KEY=""

# Contact string appended to our User-Agent so the cinema chains can reach a
# human if our crawler ever misbehaves.
SCRAPER_CONTACT="cinescrape (+mailto:you@example.com)"
